# Set these only in the EU-hosted app environment, never in the storefront.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_PROXY_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NUTRITION_POLICY_VERSION=v1
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
LOGMEAL_API_TOKEN=
# Preferred: the LogMeal APIUser token required for end-user photo recognition.
LOGMEAL_API_USER_TOKEN=
LOGMEAL_IMAGE_ANALYSIS_ENABLED=false
LOGMEAL_DPA_APPROVED=false
# Optional: enables Cala-backed price estimates for the weekly basket. Never expose this key in the browser.
CALA_API_KEY=
# Enables server-side daily meal variety through the existing OpenAI Coach connection.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
