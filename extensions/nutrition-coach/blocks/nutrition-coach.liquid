{{ 'nutrition-coach.css' | asset_url | stylesheet_tag }}

<section class="qv-nutrition-coach" aria-label="Quota Vita Nutrition Coach">
  <div class="qv-nutrition-coach__embed-shell">
    <iframe
      class="qv-nutrition-coach__embed"
      src="https://coach.quotavita.com"
      title="Quota Vita daily nutrition coach"
      loading="lazy"
      allow="camera"
    ></iframe>
  </div>
  <p class="qv-nutrition-coach__privacy">
    Your anonymous plan stays in this browser. Sign in from the Coach only when you choose to save a plan.
  </p>
</section>

{% schema %}
{
  "name": "Nutrition Coach",
  "target": "section",
  "stylesheet": "nutrition-coach.css",
  "settings": []
}
{% endschema %}
