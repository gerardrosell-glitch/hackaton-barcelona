# Copy to shopify.app.toml after creating/linking the custom app with Shopify CLI.
# The real file is gitignored: it carries your client ID and deployment URL.
client_id = "REPLACE_WITH_SHOPIFY_CLIENT_ID"
name = "Quota Vita Nutrition Coach"
application_url = "https://REPLACE_WITH_EU_HOSTED_APP_URL"
embedded = false

[access_scopes]
# Learn more at https://shopify.dev/docs/apps/tools/cli/configuration#access_scopes
scopes = "write_app_proxy,read_customers,write_customers"
optional_scopes = [ ]
use_legacy_install_flow = false

[auth]
redirect_urls = [ ]

[app_proxy]
# Must match the deployed function path, not the storefront prefix.
url = "https://REPLACE_WITH_EU_HOSTED_APP_URL/api/proxy"
prefix = "apps"
subpath = "nutrition-coach"

[webhooks]
api_version = "2025-10"
